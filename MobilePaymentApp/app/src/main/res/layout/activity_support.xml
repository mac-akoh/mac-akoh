<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.support.SupportActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/textViewSupportTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Help &amp; Support"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/textViewFaqLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Frequently Asked Questions (FAQs)"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/textViewSupportTitle"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp"/>

        <TextView
            android:id="@+id/textViewFaqContentPlaceholder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Q1: How do I reset my password?\nA: Go to Login > Forgot Password.\n\nQ2: How do I view my transaction history?\nA: Navigate to 'View Transaction History' from the main screen.\n\n(More FAQs will be listed here or loaded into a RecyclerView)"
            android:lineSpacingMultiplier="1.2"
            app:layout_constraintTop_toBottomOf="@id/textViewFaqLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

        <View
            android:id="@+id/dividerFaqContact"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            app:layout_constraintTop_toBottomOf="@id/textViewFaqContentPlaceholder"
            android:layout_marginTop="24dp"/>

        <TextView
            android:id="@+id/textViewContactLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contact Us"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/dividerFaqContact"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp"/>

        <TextView
            android:id="@+id/textViewContactEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email: support@examplemobilepayment.app (Placeholder)"
            android:drawableStart="@android:drawable/ic_dialog_email"
            android:drawablePadding="8dp"
            app:layout_constraintTop_toBottomOf="@id/textViewContactLabel"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/textViewContactPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone: +1-800-555-0199 (Placeholder)"
            android:drawableStart="@android:drawable/ic_menu_call"
            android:drawablePadding="8dp"
            app:layout_constraintTop_toBottomOf="@id/textViewContactEmail"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/buttonContactSupport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Contact Live Support (Placeholder)"
            app:layout_constraintTop_toBottomOf="@id/textViewContactPhone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
